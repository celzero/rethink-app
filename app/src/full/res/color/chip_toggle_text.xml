<?xml version="1.0" encoding="utf-8"?>
<!-- Toggle-chip text (Allowed/Blocked on the home logs card): selection is
     conveyed by full-contrast text on the selected chip and a dimmed label
     on the unselected one; no green/red tinting. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="?attr/primaryTextColor" />
    <item android:color="?attr/primaryLightColorText" />
</selector>
