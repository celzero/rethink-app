<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="80dp">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/fhs_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/fhs_control_cluster"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="720dp"
            android:layout_gravity="center_horizontal"
            android:paddingBottom="32dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/fhs_protection_bar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/fhs_protection_level_txt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    tools:text="Lockdown with RPN"
                    android:textAllCaps="true"
                    android:textColor="?attr/accentGood"
                    android:textSize="@dimen/default_font_text_view"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/fhs_active_since_txt"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/fhs_active_since_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxWidth="120dp"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/small_font_text_view"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/fhs_wide_split_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.58" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/fhs_dns_split_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.406" />

            <LinearLayout
                android:id="@+id/fhs_firewall_badges_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="2dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/fhs_wide_split_guideline"
                app:layout_constraintTop_toBottomOf="@id/fhs_protection_bar">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/fhs_card_firewall_rules_card"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/fhs_firewall_rules_pager"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:contentDescription="@string/hsf_rules_pager_desc" />

                        <LinearLayout
                            android:id="@+id/fhs_firewall_pager_dots"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_horizontal"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/fhs_rules_dot_0"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:alpha="0.35"
                                android:background="@drawable/ic_circle"
                                android:backgroundTint="?attr/primaryLightColorText" />

                            <View
                                android:id="@+id/fhs_rules_dot_1"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginStart="6dp"
                                android:alpha="0.35"
                                android:background="@drawable/ic_circle"
                                android:backgroundTint="?attr/primaryLightColorText" />

                            <View
                                android:id="@+id/fhs_rules_dot_2"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginStart="6dp"
                                android:alpha="0.35"
                                android:background="@drawable/ic_circle"
                                android:backgroundTint="?attr/primaryLightColorText" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fhs_throughput_ll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp"
                app:layout_constraintBottom_toBottomOf="@id/fhs_firewall_badges_row"
                app:layout_constraintEnd_toStartOf="@id/fhs_wide_split_guideline"
                app:layout_constraintStart_toEndOf="@id/fhs_dns_split_guideline"
                app:layout_constraintTop_toTopOf="@id/fhs_firewall_badges_row">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/fhs_internet_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        tools:text="▲ 0.00 ▼ 0.00"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="@dimen/small_font_text_view" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/fhs_internet_speed_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="B/S"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/mini_font_text_view" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fhs_card_dns_ll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp"
                app:layout_constraintBottom_toBottomOf="@id/fhs_firewall_badges_row"
                app:layout_constraintEnd_toStartOf="@id/fhs_dns_split_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/fhs_firewall_badges_row">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:id="@+id/fhs_dns_text_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/fhs_card_dns_connected_dns"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="marquee"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            tools:text="DNS · Connected"
                            android:textColor="?attr/primaryTextColor"
                            android:textSize="@dimen/large_font_text_view" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/fhs_card_dns_latency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="marquee"
                            tools:text="BLR(– ms)"
                            android:textColor="?attr/primaryLightColorText"
                            android:textSize="@dimen/small_font_text_view" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fhs_card_proxy_ll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/fhs_wide_split_guideline"
                app:layout_constraintTop_toBottomOf="@id/fhs_firewall_badges_row">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/fhs_card_other_proxy_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        tools:text="WireGuard"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="@dimen/large_font_text_view" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="18dp" />

                    <LinearLayout
                        android:id="@+id/fhs_proxy_health_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/fhs_proxy_bar_active"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="2dp"
                                android:layout_weight="1"
                                android:background="?attr/accentGood" />

                            <View
                                android:id="@+id/fhs_proxy_bar_idle"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="2dp"
                                android:layout_weight="1"
                                android:background="?attr/accentWarning" />

                            <View
                                android:id="@+id/fhs_proxy_bar_failing"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="2dp"
                                android:layout_weight="1"
                                android:background="?attr/accentBad" />
                            <View
                                android:id="@+id/fhs_proxy_bar_stopped"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="?attr/primaryLightColorText"
                                android:visibility="gone" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <View
                                        android:id="@+id/fhs_proxy_dot_active"
                                        android:layout_width="5dp"
                                        android:layout_height="5dp"
                                        android:background="@drawable/ic_circle"
                                        android:backgroundTint="?attr/accentGood" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/fhs_proxy_live_count"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="2dp"
                                        android:fontFamily="monospace"
                                        android:maxLines="1"
                                        tools:text="0"
                                        android:textColor="?attr/accentGood"
                                        android:textSize="@dimen/default_font_text_view" />
                                </LinearLayout>

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.85"
                                    android:ellipsize="end"
                                    android:gravity="center_horizontal"
                                    android:letterSpacing="0.05"
                                    android:maxLines="1"
                                    android:text="@string/lbl_active"
                                    android:textAllCaps="true"
                                    android:textColor="?attr/primaryLightColorText"
                                    app:autoSizeMaxTextSize="8sp"
                                    app:autoSizeMinTextSize="6sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <View
                                        android:id="@+id/fhs_proxy_dot_idle"
                                        android:layout_width="5dp"
                                        android:layout_height="5dp"
                                        android:background="@drawable/ic_circle"
                                        android:backgroundTint="?attr/accentWarning" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/fhs_proxy_idle_count"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="2dp"
                                        android:fontFamily="monospace"
                                        android:maxLines="1"
                                        tools:text="0"
                                        android:textColor="?attr/accentWarning"
                                        android:textSize="@dimen/default_font_text_view" />
                                </LinearLayout>

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.85"
                                    android:ellipsize="end"
                                    android:gravity="center_horizontal"
                                    android:letterSpacing="0.05"
                                    android:maxLines="1"
                                    android:text="@string/lbl_idle"
                                    android:textAllCaps="true"
                                    android:textColor="?attr/primaryLightColorText"
                                    app:autoSizeMaxTextSize="8sp"
                                    app:autoSizeMinTextSize="6sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <View
                                        android:id="@+id/fhs_proxy_dot_failing"
                                        android:layout_width="5dp"
                                        android:layout_height="5dp"
                                        android:background="@drawable/ic_circle"
                                        android:backgroundTint="?attr/accentBad" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/fhs_proxy_failing_count"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="2dp"
                                        android:fontFamily="monospace"
                                        android:maxLines="1"
                                        tools:text="0"
                                        android:textColor="?attr/accentBad"
                                        android:textSize="@dimen/default_font_text_view" />
                                </LinearLayout>

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.85"
                                    android:ellipsize="end"
                                    android:gravity="center_horizontal"
                                    android:letterSpacing="0.05"
                                    android:maxLines="1"
                                    android:text="@string/status_failing"
                                    android:textAllCaps="true"
                                    android:textColor="?attr/primaryLightColorText"
                                    app:autoSizeMaxTextSize="8sp"
                                    app:autoSizeMinTextSize="6sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/fhs_proxy_stopped_column"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <View
                                        android:id="@+id/fhs_proxy_dot_stopped"
                                        android:layout_width="5dp"
                                        android:layout_height="5dp"
                                        android:background="@drawable/ic_circle"
                                        android:backgroundTint="?attr/primaryLightColorText" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/fhs_proxy_stopped_count"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="2dp"
                                        android:fontFamily="monospace"
                                        android:maxLines="1"
                                        tools:text="0"
                                        android:textColor="?attr/primaryLightColorText"
                                        android:textSize="@dimen/default_font_text_view" />
                                </LinearLayout>

                                <androidx.appcompat.widget.AppCompatTextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.85"
                                    android:ellipsize="end"
                                    android:gravity="center_horizontal"
                                    android:letterSpacing="0.05"
                                    android:maxLines="1"
                                    android:text="@string/lbl_stopped"
                                    android:textAllCaps="true"
                                    android:textColor="?attr/primaryLightColorText"
                                    app:autoSizeMaxTextSize="8sp"
                                    app:autoSizeMinTextSize="6sp"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeTextType="uniform" />
                            </LinearLayout>

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fhs_card_apps_cv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="2dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/fhs_wide_split_guideline"
                app:layout_constraintTop_toBottomOf="@id/fhs_card_proxy_ll">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:id="@+id/fhs_apps_count_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/fhs_card_allowed_apps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            tools:text="459"
                            android:textColor="?attr/primaryTextColor"
                            android:textSize="@dimen/home_screen_stat_text" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/fhs_card_apps_all_apps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.8"
                            android:fontFamily="monospace"
                            tools:text="/461"
                            android:textColor="?attr/primaryLightColorText"
                            android:textSize="@dimen/large_font_text_view" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/fhs_apps_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:alpha="0.8"
                            android:text="@string/apps_info_title"
                            android:textAllCaps="true"
                            android:textColor="?attr/primaryLightColorText"
                            android:textSize="@dimen/default_font_text_view" />
                    </LinearLayout>

                    <androidx.constraintlayout.helper.widget.Flow
                        android:id="@+id/fhs_apps_flow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="8dp"
                        app:constraint_referenced_ids="fhs_card_apps_blocked_count,fhs_card_apps_isolated_count,fhs_card_apps_bypassed_count,fhs_card_apps_excluded_count"
                        app:flow_horizontalBias="0"
                        app:flow_horizontalGap="12dp"
                        app:flow_horizontalStyle="packed"
                        app:flow_maxElementsWrap="2"
                        app:flow_verticalGap="6dp"
                        app:flow_wrapMode="aligned"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/fhs_apps_arrow"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/fhs_apps_count_container" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/fhs_card_apps_blocked_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:letterSpacing="0.02"
                        tools:text="0 blocked"
                        android:textAllCaps="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/small_font_text_view"
                        tools:ignore="MissingConstraints" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/fhs_card_apps_isolated_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:letterSpacing="0.02"
                        tools:text="1 isolated"
                        android:textAllCaps="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/small_font_text_view"
                        tools:ignore="MissingConstraints" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/fhs_card_apps_bypassed_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:letterSpacing="0.02"
                        tools:text="0 bypassed"
                        android:textAllCaps="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/small_font_text_view"
                        tools:ignore="MissingConstraints" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/fhs_card_apps_excluded_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:letterSpacing="0.02"
                        tools:text="0 excluded"
                        android:textAllCaps="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/small_font_text_view"
                        tools:ignore="MissingConstraints" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/fhs_apps_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:alpha="0.8"
                        android:text="›"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="20sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/fhs_row2_bottom_barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="fhs_card_proxy_ll,fhs_card_apps_cv" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fhs_card_logs_ll"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="18dp"
                app:layout_constraintBottom_toBottomOf="@id/fhs_row2_bottom_barrier"
                app:layout_constraintEnd_toStartOf="@id/fhs_wide_split_guideline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fhs_throughput_ll">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/fhs_logs_pager"
                            android:layout_width="match_parent"
                            android:layout_height="168dp"
                            android:contentDescription="@string/logs_card_pager_desc" />

                        <LinearLayout
                            android:id="@+id/fhs_logs_dots"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/fhs_logs_dot_0"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:alpha="0.35"
                                android:background="@drawable/ic_circle"
                                android:backgroundTint="?attr/primaryLightColorText" />

                            <View
                                android:id="@+id/fhs_logs_dot_1"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginStart="6dp"
                                android:alpha="0.35"
                                android:background="@drawable/ic_circle"
                                android:backgroundTint="?attr/primaryLightColorText" />
                        </LinearLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/fhs_logs_disabled_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/fhs_logs_disabled_txt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:alpha="0.8"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="?attr/primaryLightColorText"
                            android:textSize="@dimen/small_font_text_view"
                            tools:text="Enable logs to see your recent activity" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/fhs_logs_enable_chip"
                            style="@style/ThinnerChip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:checkable="false"
                            android:text="@string/lbl_enable"
                            android:textColor="?attr/primaryTextColor"
                            android:textSize="@dimen/small_font_text_view"
                            android:visibility="gone"
                            app:chipBackgroundColor="?attr/homeScreenBtnBackground"
                            app:chipEndPadding="4dp"
                            app:chipMinHeight="24dp"
                            app:chipStartPadding="4dp"
                            app:chipStrokeColor="@color/chip_toggle_stroke"
                            app:chipStrokeWidth="1dp"
                            tools:visibility="visible" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fhs_control_cluster"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintWidth_max="720dp"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_fragment_pause_icon"
            android:layout_width="50dp"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pause"
                app:tint="?attr/primaryTextColor" />
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/fhs_start_btn_border_container"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/home_fragment_bottom_sheet_icon"
            app:layout_constraintStart_toEndOf="@id/home_fragment_pause_icon"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fhs_dns_on_off_btn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.15"
                tools:text="START"
                android:textAllCaps="true"
                android:textColor="?attr/invertedPrimaryTextColor"
                android:textSize="@dimen/extra_large_font_text_view"
                android:textStyle="bold"
                app:cornerRadius="28dp" />

            <View
                android:id="@+id/fhs_animated_border_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="false"
                android:elevation="1dp"
                android:focusable="false"
                android:visibility="gone" />

        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_fragment_bottom_sheet_icon"
            android:layout_width="50dp"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_down"
                app:tint="?attr/primaryTextColor" />
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
