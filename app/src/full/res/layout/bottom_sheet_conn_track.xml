<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bs_conn_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/bs_conn_top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:background="?attr/border" />

       <com.google.android.material.card.MaterialCardView
            android:id="@+id/bs_conn_hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <!-- app identity; tappable, opens app info. the icon is shared
                     by both lines: name on top, verdict below it -->
                <LinearLayout
                    android:id="@+id/bs_conn_track_app_name_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/bs_conn_track_app_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/apps_icon_content_desc"
                        android:src="@drawable/default_app_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/bs_conn_track_app_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="start"
                            android:maxLines="1"
                            android:textColor="?attr/primaryTextColor"
                            android:textSize="@dimen/heading_font_text_view"
                            android:textStyle="bold"
                            tools:text="App Name" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/bs_conn_track_port_detail_chip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="?attr/primaryLightColorText"
                            android:textSize="@dimen/small_font_text_view"
                            tools:text="Allowed · TCP/443 · 2m ago" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:alpha="0.5"
                        android:contentDescription="@string/bsct_app_info"
                        android:src="@drawable/ic_right_arrow_small"
                        app:tint="?attr/primaryLightColorText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bs_conn_track_app_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/bs_conn_track_app_info_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@string/bsct_app_info"
                        tools:src="@drawable/ic_block" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bs_conn_track_app_info_txt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="Blocked by firewall rule" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:alpha="0.5"
                        android:contentDescription="@string/bsct_app_info"
                        android:src="@drawable/ic_right_arrow_small"
                        app:tint="?attr/primaryLightColorText" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:alpha="0.5"
                    android:background="?attr/border" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0.55"
                    android:text="@string/bsct_meta_destination"
                    android:textAllCaps="true"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/mini_font_text_view" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bs_conn_connection_flag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="none"
                        android:gravity="center"
                        android:minWidth="22dp"
                        android:singleLine="true"
                        android:textSize="18sp"
                        tools:text="🇩🇪" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bs_conn_connection_type_heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="?attr/primaryTextColor"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/default_font_text_view"
                        android:typeface="monospace"
                        tools:text="142.250.77.238" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0.55"
                    android:text="@string/lbl_domain"
                    android:textAllCaps="true"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/mini_font_text_view" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/bs_conn_dns_cache_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/primaryLightColorText"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/default_font_text_view"
                    android:visibility="gone"
                    tools:text="🇩🇪 example.com"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:alpha="0.55"
                        android:text="@string/bsct_meta_info"
                        android:textAllCaps="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/mini_font_text_view" />

                    <LinearLayout
                        android:id="@+id/bs_conn_summary_detail_ll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/bs_conn_conn_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:textColor="?attr/primaryLightColorText"
                            android:textSize="@dimen/default_font_text_view"
                            tools:text="⏱ 4m" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/bs_conn_conn_upload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="?attr/primaryLightColorText"
                            android:textSize="@dimen/default_font_text_view"
                            tools:text="⬆ 12 kB" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/bs_conn_conn_download"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="?attr/primaryLightColorText"
                            android:textSize="@dimen/default_font_text_view"
                            tools:text="⬇ 86 kB" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/bs_conn_conn_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-light"
                            android:textColor="?attr/primaryLightColorText"
                            android:textSize="@dimen/default_font_text_view"
                            tools:text="🌐" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bs_conn_conn_type_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        android:visibility="gone"
                        tools:text="🌐 Unmetered"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:textAllCaps="true"
            android:text="@string/lbl_rules"
            android:textColor="?attr/primaryTextColor"
            android:textSize="@dimen/default_font_text_view" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bs_conn_rules_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/bs_conn_rule_row_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bs_conn_app_rule_heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lbl_app_rules"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="@dimen/large_font_text_view" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bs_conn_app_rule_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/bsdl_rule_status_none"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="Allowed" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/lbl_app_rules"
                        android:src="@drawable/ic_right_arrow_small"
                        app:tint="?attr/primaryLightColorText" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/border" />

                <LinearLayout
                    android:id="@+id/bs_conn_rule_row_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/bs_conn_ip_rule_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="middle"
                            android:fontFamily="sans-serif-light"
                            android:maxLines="1"
                            android:textColor="?attr/primaryTextColor"
                            android:textSize="@dimen/large_font_text_view"
                            tools:text="142.250.77.238" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bs_conn_ip_rule_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/bsdl_rule_status_none"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="Blocked" />

                    <com.celzero.bravedns.ui.custom.RuleStateSwitch
                        android:id="@+id/bs_conn_ip_rule_switch"
                        android:layout_width="@dimen/rule_state_switch_width"
                        android:layout_height="@dimen/rule_state_switch_height"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/lbl_ip_rules" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"
                    android:background="?attr/border" />

                <LinearLayout
                    android:id="@+id/bs_conn_rule_row_domain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/bs_conn_domain_rule_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="middle"
                            android:fontFamily="sans-serif-light"
                            android:maxLines="1"
                            android:textColor="?attr/primaryTextColor"
                            android:textSize="@dimen/large_font_text_view"
                            tools:text="example.com" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bs_conn_domain_rule_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/bsdl_rule_status_none"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="Trusted" />

                    <com.celzero.bravedns.ui.custom.RuleStateSwitch
                        android:id="@+id/bs_conn_domain_rule_switch"
                        android:layout_width="@dimen/rule_state_switch_width"
                        android:layout_height="@dimen/rule_state_switch_height"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/lbl_domain_rules" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bs_conn_blocked_rule2_header_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/border"
            app:strokeWidth="1dp"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/bs_conn_unknown_app_txt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/univ_firewall_rule_3"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="@dimen/large_font_text_view" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/bs_conn_unknown_app_check"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/connection_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:alpha="0.7"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="?attr/primaryLightColorText"
            android:textIsSelectable="true"
            android:textSize="@dimen/mini_font_text_view"
            tools:text="message" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
