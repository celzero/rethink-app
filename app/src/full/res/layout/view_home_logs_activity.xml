<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/fhs_logs_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@id/fhs_logs_toggle_group"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/fhs_logs_allowed_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/fhs_card_allowed_logs_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="?attr/primaryTextColor"
                android:textSize="@dimen/heading_font_text_view"
                tools:text="62K" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/fhs_card_allowed_logs_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:ellipsize="end"
                android:letterSpacing="0.15"
                android:maxLines="1"
                android:text="@string/lbl_allowed"
                android:textAllCaps="true"
                android:textColor="?attr/primaryLightColorText"
                android:textSize="@dimen/small_font_text_view" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fhs_logs_blocked_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/fhs_card_blocked_logs_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="?attr/primaryLightColorText"
                android:textSize="@dimen/heading_font_text_view"
                tools:text="65K" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/fhs_card_blocked_logs_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:ellipsize="end"
                android:letterSpacing="0.15"
                android:maxLines="1"
                android:text="@string/lbl_blocked"
                android:textAllCaps="true"
                android:textColor="?attr/primaryLightColorText"
                android:textSize="@dimen/small_font_text_view" />
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/fhs_logs_toggle_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/fhs_logs_allowed_chip"
            style="@style/ThinnerChip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="true"
            android:text="@string/lbl_allowed"
            android:textColor="@color/chip_toggle_text"
            android:textSize="@dimen/small_font_text_view"
            app:chipBackgroundColor="?attr/homeScreenBtnBackground"
            app:chipEndPadding="4dp"
            app:chipStartPadding="4dp"
            app:chipStrokeColor="@color/chip_toggle_stroke"
            app:chipStrokeWidth="1dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/fhs_logs_blocked_chip"
            style="@style/ThinnerChip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/lbl_blocked"
            android:textColor="@color/chip_toggle_text"
            android:textSize="@dimen/small_font_text_view"
            app:chipBackgroundColor="?attr/homeScreenBtnBackground"
            app:chipEndPadding="4dp"
            app:chipMinHeight="24dp"
            app:chipStartPadding="4dp"
            app:chipStrokeColor="@color/chip_toggle_stroke"
            app:chipStrokeWidth="1dp" />
    </com.google.android.material.chip.ChipGroup>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/fhs_card_logs_duration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.8"
        android:layout_marginEnd="4dp"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:text="@string/logs_card_heatmap_window"
        android:textColor="?attr/primaryLightColorText"
        android:textSize="@dimen/extra_small_font_text_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@id/fhs_logs_toggle_group"
        app:layout_constraintTop_toBottomOf="@id/fhs_logs_toggle_group"
        tools:text="Last 24 hours" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/fhs_logs_top_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="fhs_logs_header,fhs_card_logs_duration" />

    <LinearLayout
        android:id="@+id/fhs_logs_hour_axis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="8"
        app:layout_constraintTop_toBottomOf="@id/fhs_logs_top_barrier"
        tools:ignore="HardcodedText">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/fhs_logs_hour_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:alpha="0.55"
            android:layout_marginStart="4dp"
            android:fontFamily="monospace"
            android:gravity="start"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:text="24"
            android:textColor="?attr/primaryLightColorText"
            android:textSize="@dimen/extra_small_font_text_view" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/fhs_logs_hour_start_plus_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:alpha="0.55"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:text="18"
            android:textColor="?attr/primaryLightColorText"
            android:textSize="@dimen/extra_small_font_text_view" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/fhs_logs_hour_start_plus_12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:alpha="0.55"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:text="12"
            android:textColor="?attr/primaryLightColorText"
            android:textSize="@dimen/extra_small_font_text_view" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/fhs_logs_hour_start_plus_18"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:alpha="0.55"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:text="6"
            android:textColor="?attr/primaryLightColorText"
            android:textSize="@dimen/extra_small_font_text_view" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:alpha="0.55"
            android:fontFamily="monospace"
            android:gravity="end"
            android:layout_marginEnd="4dp"
            android:letterSpacing="0.05"
            android:maxLines="1"
            android:text="now"
            android:textColor="?attr/primaryLightColorText"
            android:textSize="@dimen/extra_small_font_text_view" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/fhs_logs_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:columnCount="24"
        android:rowCount="6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_min="60dp"
        app:layout_constraintTop_toBottomOf="@id/fhs_logs_hour_axis" />

</androidx.constraintlayout.widget.ConstraintLayout>
