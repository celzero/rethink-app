<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dns_block_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/dns_block_top_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:background="?attr/border" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dns_block_hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/dns_block_header_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/dns_block_fav_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:color/transparent"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_block_header_flag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="24dp"
                        android:textSize="18sp"
                        android:visibility="gone"
                        tools:text="🇩🇪"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/dns_block_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="start"
                            android:maxLines="2"
                            android:textColor="?attr/primaryTextColor"
                            android:textSize="@dimen/heading_font_text_view"
                            android:textStyle="bold"
                            tools:text="example.com" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/dns_block_blocked_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="?attr/primaryLightColorText"
                            android:textSize="@dimen/default_font_text_view"
                            tools:text="blocked 4m ago" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:alpha="0.5"
                        android:contentDescription="@string/bsdl_open_domain_connections"
                        android:src="@drawable/ic_right_arrow_small"
                        app:tint="?attr/primaryLightColorText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dns_block_blocklist_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/dns_block_blocklist_info_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@string/bsdl_meta_app"
                        tools:src="@drawable/ic_block" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_block_blocklist_info_txt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="Blocked by firewall rule" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/dns_block_blocklist_info_arrow"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:alpha="0.5"
                        android:contentDescription="@string/bsdl_open_domain_connections"
                        android:src="@drawable/ic_right_arrow_small"
                        app:tint="?attr/primaryLightColorText" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:alpha="0.5"
                    android:background="?attr/border" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0.55"
                    android:text="@string/bsdl_meta_app"
                    android:textAllCaps="true"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/mini_font_text_view" />

                <LinearLayout
                    android:id="@+id/dns_app_name_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/dns_app_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/apps_icon_content_desc"
                        android:src="@drawable/default_app_icon" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_app_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="Firefox (10100)" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:alpha="0.55"
                    android:text="@string/bsdl_meta_response"
                    android:textAllCaps="true"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/mini_font_text_view" />

                <LinearLayout
                    android:id="@+id/dns_block_ip_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_block_connection_flag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="none"
                        android:gravity="center"
                        android:minWidth="22dp"
                        android:singleLine="true"
                        android:textSize="18sp"
                        tools:text="🇩🇪" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_block_ip_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="?attr/primaryTextColor"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/default_font_text_view"
                        android:typeface="monospace"
                        tools:text="142.250.77.238" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_block_ip_latency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/drawable_purple_gradient"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:singleLine="true"
                        android:textAlignment="center"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/mini_font_text_view"
                        tools:text="TTL 300" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dns_block_type_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.55"
                        android:text="@string/bsdl_meta_query_type"
                        android:textAllCaps="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/mini_font_text_view" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_record_type_chip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-light"
                        android:maxLines="1"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/small_font_text_view"
                        tools:text="A" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dns_block_info_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:alpha="0.55"
                        android:text="@string/bsdl_meta_resolver"
                        android:textAllCaps="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/mini_font_text_view" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_block_info_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:textColor="?attr/primaryLightColorText"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/small_font_text_view"
                        tools:text="by 9.9.9.9 via ORBOT" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dns_blocked_target_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:visibility="gone">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:alpha="0.55"
                        android:text="@string/bsdl_meta_alias"
                        android:textAllCaps="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/mini_font_text_view" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_blocked_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:textColor="?attr/primaryLightColorText"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="cname.example.net" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dns_region_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:visibility="gone">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:alpha="0.55"
                        android:text="@string/bsdl_meta_region"
                        android:textAllCaps="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/mini_font_text_view" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_region"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-smallcaps"
                        android:maxLines="1"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="Germany" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bsdl_rules_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:rippleColor="#22000000"
            app:strokeColor="?attr/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/bsdl_rules_domain_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.55"
                    android:ellipsize="middle"
                    android:fontFamily="sans-serif-light"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/mini_font_text_view"
                    tools:text="example.com" />

                <LinearLayout
                    android:id="@+id/bsdl_rule_row_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/bsdl_rule_app_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bsdl_rule_scope_app_title"
                            android:textColor="?attr/primaryTextColor"
                            android:textSize="@dimen/large_font_text_view" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bsdl_app_rule_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/bsdl_rule_status_none"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="No rule" />

                    <com.celzero.bravedns.ui.custom.RuleStateSwitch
                        android:id="@+id/bsdl_app_rule_switch"
                        android:layout_width="@dimen/rule_state_switch_width"
                        android:layout_height="@dimen/rule_state_switch_height"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/bsdl_rule_scope_app_title" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bsdl_rule_row_global"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/bsdl_rule_scope_global_title"
                            android:textColor="?attr/primaryTextColor"
                            android:textSize="@dimen/large_font_text_view" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bsdl_global_rule_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/bsdl_rule_status_none"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="No rule" />

                    <com.celzero.bravedns.ui.custom.RuleStateSwitch
                        android:id="@+id/bsdl_global_rule_switch"
                        android:layout_width="@dimen/rule_state_switch_width"
                        android:layout_height="@dimen/rule_state_switch_height"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@string/bsdl_rule_scope_global_title" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/dns_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.7"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:maxLines="5"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="?attr/primaryLightColorText"
            android:textIsSelectable="true"
            android:textSize="@dimen/mini_font_text_view"
            tools:text="message" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
