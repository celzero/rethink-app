<?xml version="1.0" encoding="utf-8"?>
<!--
    Confirmation dialog shown before importing rules from a file.
    DEBUG builds only — never shown in release builds.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/background"
    android:padding="10dp">

    <!-- Dialog title -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dic_title"
        style="@style/TextAppearance.AppCompat.Subhead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="@string/import_rules_dialog_title"
        android:textSize="@dimen/large_font_text_view"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- File row -->
    <LinearLayout
        android:id="@+id/dic_file_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/dic_title">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/import_rules_file_label"
            android:textSize="@dimen/default_font_text_view"
            android:textColor="?attr/primaryLightColorText" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/dic_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textSize="@dimen/default_font_text_view"
            android:textColor="?attr/primaryTextColor" />

    </LinearLayout>

    <!-- Valid entries row -->
    <LinearLayout
        android:id="@+id/dic_valid_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/dic_file_row">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/import_rules_valid_label"
            android:textSize="@dimen/default_font_text_view"
            android:textColor="?attr/primaryLightColorText" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/dic_valid_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="@dimen/default_font_text_view"
            android:textColor="?attr/primaryTextColor" />

    </LinearLayout>

    <!-- Ignored / invalid count row -->
    <LinearLayout
        android:id="@+id/dic_ignored_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/dic_valid_row">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/import_rules_ignored_label"
            android:textSize="@dimen/default_font_text_view"
            android:textColor="?attr/primaryLightColorText" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/dic_ignored_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="@dimen/default_font_text_view"
            android:textColor="?attr/primaryTextColor" />

    </LinearLayout>

    <!-- Action section label -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dic_action_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="12dp"
        android:text="@string/import_rules_action_label"
        android:textSize="@dimen/default_font_text_view"
        android:textColor="?attr/primaryLightColorText"
        app:layout_constraintTop_toBottomOf="@id/dic_ignored_row" />

    <!-- Block / Allow radio group -->
    <RadioGroup
        android:id="@+id/dic_action_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toBottomOf="@id/dic_action_label">

        <RadioButton
            android:id="@+id/dic_block_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/ci_block"
            android:textSize="@dimen/large_font_text_view"
            android:textColor="?attr/primaryTextColor" />

        <!-- Label is set programmatically: "Trust" for app-specific, "Bypass Universal" for global -->
        <RadioButton
            android:id="@+id/dic_allow_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/ci_trust_rule"
            android:textSize="@dimen/large_font_text_view"
            android:textColor="?attr/primaryTextColor" />

    </RadioGroup>

    <!-- Cancel / Import buttons -->
    <LinearLayout
        android:id="@+id/dic_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/dic_action_group">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dic_cancel_btn"
            style="@style/Widget.Material3.Button.TextButton.Dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_cancel"
            android:textColor="?attr/accentGood"
            android:textSize="@dimen/large_font_text_view" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dic_import_btn"
            style="@style/Widget.Material3.Button.TextButton.Dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/import_rules_btn"
            android:textColor="?attr/accentGood"
            android:textSize="@dimen/large_font_text_view" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
