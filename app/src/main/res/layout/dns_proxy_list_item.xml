<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dns_proxy_list_parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp">

    <RelativeLayout
        android:id="@+id/dns_proxy_list_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/dns_proxy_list_action_image"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/dns_proxy_list_url_flag_text"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dns_proxy_list_url_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/primaryTextColor" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dns_proxy_list_url_explanation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/primaryLightColorText" />

            </LinearLayout>

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dns_proxy_list_action_image"
            android:alpha="0.55"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="4dp"
            android:layout_toStartOf="@id/dns_proxy_list_selection_indicator"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:tint="?attr/primaryTextColor"
            android:padding="12dp"
            android:src="@drawable/ic_fab_uninstall" />

        <FrameLayout
            android:id="@+id/dns_proxy_list_selection_indicator"
            android:layout_width="32dp"
            android:layout_height="18dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp">

            <View
                android:id="@+id/dns_proxy_list_selection_orbital"
                android:layout_width="@dimen/selection_orbital_size"
                android:layout_height="@dimen/selection_orbital_size"
                android:layout_gravity="center"
                android:background="@drawable/bg_selection_orbital"
                android:contentDescription="@null"
                android:visibility="gone" />

            <View
                android:id="@+id/dns_proxy_list_selection_pill"
                android:layout_width="@dimen/selection_pill_width"
                android:layout_height="@dimen/selection_pill_height"
                android:layout_gravity="center"
                android:background="@drawable/bg_selection_switch"
                android:contentDescription="@null"
                android:visibility="gone" />

        </FrameLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
