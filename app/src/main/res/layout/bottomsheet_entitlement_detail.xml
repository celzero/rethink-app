<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?attr/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <View
            android:id="@+id/drag_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="?attr/border"
            android:alpha="0.5" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Entitlement Details"
            android:textAlignment="center"
            android:textColor="?attr/primaryTextColor"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_comparison_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAlignment="center"
            android:textColor="?attr/primaryLightColorText"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="✅"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/border"
            app:cardBackgroundColor="?attr/background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <include
                    android:id="@+id/row_rpn_active"
                    layout="@layout/layout_entitlement_row" />

                <include
                    android:id="@+id/row_status"
                    layout="@layout/layout_entitlement_row" />

                <include
                    android:id="@+id/row_cid"
                    layout="@layout/layout_entitlement_row" />

                <include
                    android:id="@+id/row_did"
                    layout="@layout/layout_entitlement_row" />

                <include
                    android:id="@+id/row_who"
                    layout="@layout/layout_entitlement_row" />

                <include
                    android:id="@+id/row_expiry"
                    layout="@layout/layout_entitlement_row" />

                <include
                    android:id="@+id/row_provider"
                    layout="@layout/layout_entitlement_row" />

                <include
                    android:id="@+id/row_token"
                    layout="@layout/layout_entitlement_row" />

                <include
                    android:id="@+id/row_allow_restore"
                    layout="@layout/layout_entitlement_row" />

                <include
                    android:id="@+id/row_test"
                    layout="@layout/layout_entitlement_row" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/restore_cv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextAppearance.AppCompat.Subhead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:textColor="?attr/primaryLightColorText"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/rpn_restore_confirm_message"
                    android:textSize="@dimen/large_font_text_view" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btn_restore"
                    style="@style/TextAppearance.AppCompat.Subhead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/rectangle_border_background"
                    android:clickable="true"
                    android:drawablePadding="-15dp"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingStart="25dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="25dp"
                    android:paddingBottom="10dp"
                    android:text="@string/rpn_restore_confirm_title"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="@dimen/large_font_text_view"/>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dismiss"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/lbl_dismiss"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
