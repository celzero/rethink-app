<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_pcap_file_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_logs"
            app:tint="?attr/primaryLightColorText" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/item_pcap_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="?attr/primaryTextColor"
                android:textSize="@dimen/default_font_text_view" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/item_pcap_file_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/primaryLightColorText"
                android:textSize="@dimen/small_font_text_view" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/item_pcap_file_view_btn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/pcap_view_file_desc"
            android:padding="5dp"
            app:icon="@drawable/ic_visibility"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="?attr/primaryLightColorText" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/item_pcap_file_delete_btn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/lbl_delete"
            android:padding="5dp"
            app:icon="@drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconTint="?attr/accentBad" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="52dp"
        android:alpha="0.5"
        android:background="?attr/border" />

</LinearLayout>
