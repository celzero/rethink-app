<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="7dp"
    android:paddingEnd="20dp"
    android:paddingBottom="7dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/rpn_stat_app_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        tools:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/rpn_stat_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/primaryTextColor"
            android:textSize="14sp"
            tools:text="Firefox" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/rpn_stat_app_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:alpha="0.7"
            android:textColor="?attr/primaryLightColorText"
            android:textSize="11sp"
            tools:text="128 conns · 210 MB 🔻 · 45 MB 🔺" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/rpn_stat_app_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="?attr/primaryTextColor"
        android:textSize="13sp"
        tools:text="255 MB" />

</LinearLayout>
