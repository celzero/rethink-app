<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Subtle gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:endColor="?attr/homeScreenBtnGradientEnd"
                android:startColor="?attr/homeScreenBtnGradientStart"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Glass edge effect -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="0.5dp"
                android:color="#1AFFFFFF" />
        </shape>
    </item>

</layer-list>
