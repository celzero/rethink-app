<?xml version="1.0" encoding="utf-8"?>
<!-- Themed circular avatar for VPN server list items.
     Unlike bg_avatar_circle (hardcoded white-alpha, tuned for hero gradients),
     this adapts to every theme so the ring remains visible on light surfaces. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/vpnHeaderGradientStart" />
    <stroke
        android:width="1dp"
        android:color="?attr/border" />
</shape>
