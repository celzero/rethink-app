<?xml version="1.0" encoding="utf-8"?>
<!--
    Single unified hero gradient for all Rethink Plus screens
    (dashboard, ping test, manage purchase, config detail, server selection).

    Theme-aware via serverHeaderGradient* attrs; corners and strokes are NOT
    baked in so the same drawable can serve full-bleed collapsing headers and
    rounded hero cards (rounding is provided by the wrapping MaterialCardView).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="?attr/serverHeaderGradientStart"
        android:centerColor="?attr/serverHeaderGradientCenter"
        android:endColor="?attr/serverHeaderGradientEnd"
        android:type="linear" />
</shape>
