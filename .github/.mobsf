---
# Configuration for mobsfscan (https://github.com/MobSF/mobsfscan).

# Source directories that never contain releasable code.
- ignore-paths:
  - build
  - .gradle
  - .artifacts

# Rules disabled and why:
#
# android_kotlin_hiddenui
#   Regex matches every occurrence of View.GONE / View.INVISIBLE.
#   Intended for sensitive data hidden in the UI (MSTG-STORAGE-7), but it
#   fires on all ordinary visibility toggles. These are plain UI state changes.
- ignore-rules:
  - android_kotlin_hiddenui
